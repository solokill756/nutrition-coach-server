PORT=3001
# LLM chat: platform (encrypted proxy) or gemini (direct API). Ollama is NOT supported for LLM.
LLM_PROVIDER=platform
LLM_WARMUP_ENABLED=
# Embeddings (vector search) still use Ollama nomic-embed-text — separate from LLM_PROVIDER
OLLAMA_BASE_URL=http://localhost:11434
AI_API_URL=
AI_APP_NAME=calorie
AI_SECRET_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
TOP_K=6
RETRIEVAL_QUERY_EXPANSION_ENABLED=true
# Retrieval: hybrid = Lunr + BM25 + pgvector + RRF, then semantic + optional LLM rerank | bm25-only | vector-only
RETRIEVAL_MODE=hybrid
RETRIEVAL_CROSS_ENCODER_LITE_ENABLED=true
# LLM predicts metadata.domain subset for retrieval; set false to search full corpus
COACH_DOMAIN_ROUTING_ENABLED=true
FOLLOWUP_MODE=template
FOLLOWUP_REPHRASE_TIMEOUT_MS=4000
CLARIFICATION_CONFIDENCE_THRESHOLD=0.7
MAX_CLARIFICATION_TURNS=3
DATA_DIR=../nutrition-rag-data/data
USE_CHUNKING=false
LUNR_CANDIDATE_LIMIT=100
MIN_CANDIDATES_BEFORE_FALLBACK=30
FALLBACK_BM25_LIMIT=300
USE_POSTGRES_STORAGE=true
POSTGRES_HOST=localhost
POSTGRES_PORT=5555
POSTGRES_USER=postgres
POSTGRES_PASSWORD=calories_counter_2024
POSTGRES_DB=calories_counter
POSTGRES_SCHEMA=public
POSTGRES_SSL=false
# Local dev only: let TypeORM create tables on an empty DB. Never enable in production.
TYPEORM_SYNCHRONIZE=false
POSTGRES_POOL_MAX=10
POSTGRES_ENABLE_PGVECTOR=true
POSTGRES_VECTOR_DIM=768
POSTGRES_VECTOR_INDEX_TYPE=hnsw
POSTGRES_EMBEDDING_MODEL=nomic-embed-text
POSTGRES_SYNC_EMBEDDINGS=true
POSTGRES_EMBEDDING_BATCH_SIZE=25
POSTGRES_SYNC_EMBEDDINGS_ON_BOOT=true
POSTGRES_VERIFY_AFTER_SYNC=true
POSTGRES_VERIFY_STRICT=true

# LogFood: auto-run ADD COLUMN IF NOT EXISTS on boot (fixes missing FoodId / DelFlag on legacy DBs). Set false in prod if you manage schema only via migrations.
LOGFOOD_AUTO_SCHEMA=true

# Auth configuration
JWT_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=30
AUTH_RESET_TOKEN_MINUTES=60

# USDA FoodData Central (food search fallback). Free key: https://fdc.nal.usda.gov/api-key-signup
# Empty uses DEMO_KEY, which is heavily rate limited.
USDA_FDC_API_KEY=

# OAuth configuration (Firebase ID token verification)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep newline characters escaped (\\n) when using .env format
FIREBASE_PRIVATE_KEY=
FIREBASE_CHECK_REVOKED=false

# Cloudflare Named Tunnel (docker-compose.prod.yml)
# Copy token from: Zero Trust > Networks > Connectors > Cloudflare Tunnels > calocounter > Configure
CLOUDFLARE_TUNNEL_TOKEN=

# Web origins allowed to call the API with credentials (comma-separated, exact origins, no path).
# The web app (cookie auth) REQUIRES its origin here: when empty, CORS stays open without credentials
# and every request from the new web build fails its preflight. Unlisted browser origins are blocked.
CORS_ORIGINS=http://localhost:5173
# Secure cookie flag. Defaults to true; set false ONLY for local http development
# (Safari drops Secure cookies on http://localhost).
# AUTH_COOKIE_SECURE=false

RAG_EMBEDDING_MODEL=bge-m3
RAG_EMBEDDING_DIM=1024
