{
  "name": "nutrition-coach-server",
  "version": "1.0.0",
  "description": "",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:dev": "nodemon --watch src --ext ts --exec \"ts-node src/main.ts\"",
    "start:dev:fast": "ts-node-dev --respawn --transpile-only src/main.ts",
    "benchmark": "ts-node scripts/benchmark-hybrid.ts",
    "setup:postgres": "node scripts/setup-postgres-schema.js",
    "sync:postgres": "node scripts/sync-chunks-to-postgres.js",
    "sync:food-embeddings": "node scripts/sync-food-embeddings.js",
    "verify:postgres": "node scripts/verify-postgres-vector.js",
    "db:food-verify-all": "node scripts/run-food-isverified-all-true.js",
    "db:import-usda-foods": "node scripts/import-usda-foods.js",
    "db:seed-admin": "node scripts/seed-admin.js",
    "db:seed-exercises": "node scripts/seed-exercises.js",
    "db:seed-test-foods": "node scripts/seed-test-foods.js",
    "test:vn-retrieval": "ts-node scripts/test-vn-regression.ts",
    "test": "jest --config jest.config.cjs",
    "test:api-integration": "node scripts/integration/api-test-runner.js",
    "test:postman:gen": "node scripts/integration/generate-postman-collection.js",
    "test:postman:run": "newman run postman/collection.json -e postman/environment.json --reporters cli,htmlextra --reporter-htmlextra-export postman/report.html",
    "test:postman": "npm run test:postman:gen && npm run test:postman:run",
    "eval:rag": "node scripts/rag-eval/run-eval.js",
    "eval:rag:compare": "node scripts/rag-eval/run-eval.js --compare",
    "eval:rag:discover": "node scripts/rag-eval/discover-relevant-docs.js",
    "eval:rag:sweep": "node scripts/rag-eval/sweep.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/typeorm": "^11.0.1",
    "axios": "^1.15.2",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "class-validator-jsonschema": "^5.2.0",
    "cookie-parser": "^1.4.7",
    "crypto": "^1.0.1",
    "dotenv": "^16.6.1",
    "firebase-admin": "^13.8.0",
    "jose": "^6.2.2",
    "lunr": "^2.3.9",
    "node-cache": "^5.1.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "slugify": "^1.6.8",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cheerio": "^0.22.35",
    "@types/cookie-parser": "^1.4.10",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.5.0",
    "@types/node-cache": "^4.1.3",
    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "jest": "^29.7.0",
    "newman": "^6.2.2",
    "newman-reporter-htmlextra": "^1.23.1",
    "nodemon": "^3.1.14",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.2"
  }
}
